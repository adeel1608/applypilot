# Copy to .env.local for local-only configuration. Never commit the copy.
APPLYPILOT_DATABASE_PATH=./data/applypilot.local.db
APPLYPILOT_DATA_DIR=./data/private
APPLYPILOT_DOCUMENT_DIR=./data/generated
APPLYPILOT_LOG_LEVEL=info
# Filenames only; the corresponding capability files stay ignored under data/private/.
APPLYPILOT_SOURCE_ALLOWLIST_FILENAME=source-allowlist.json
APPLYPILOT_RUNNER_ALLOWLIST_FILENAME=runner-target-allowlist.json
